{
  "name": "@maestro/api",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:server": "tsx scripts/dev-db.ts",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "dev": "node -r @swc-node/register --watch --env-file=.env src/main.ts",
    "test": "npm run test:unit && npm run test:http",
    "test:unit": "node --import tsx --test \"test/**/*.test.*\"",
    "test:http": "node -r @swc-node/register --test \"test/**/*.spec.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
