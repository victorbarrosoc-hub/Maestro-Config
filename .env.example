# Banco
#
# Desenvolvimento sem instalar nada: `npm -w @maestro/api run db:server` sobe um
# Postgres embutido (PGlite) na 5432. Use a linha abaixo como está.
#
# `connection_limit=1` e `pgbouncer=true` não são enfeite: o PGlite atende todas
# as conexões numa sessão só, então prepared statement com nome repetido colide
# ("prepared statement s0 already exists"). Com Postgres de verdade, remova os
# dois parâmetros.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&connection_limit=1&pgbouncer=true"

# Auth
JWT_SECRET="troque-isto"
SESSION_DAYS=30
MAGIC_TOKEN_MINUTES=15
INVITE_TOKEN_DAYS=7

# Aprovação — janela de resfriamento (D-025)
APPROVAL_NOTIFY_DELAY_SECONDS=60

# Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="maestro-dev"

# Notificações
RESEND_API_KEY=""
WHATSAPP_TOKEN=""

# IA — Approval Assistant (nunca no caminho crítico, timeout 3s)
ANTHROPIC_API_KEY=""
AI_TIMEOUT_MS=3000

# Integrações
META_APP_ID=""
META_APP_SECRET=""
